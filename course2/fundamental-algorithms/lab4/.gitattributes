# Linux-файлы - всегда с переводами строк LF (иначе bash не запустит run_tests.sh)
*       text=auto eol=lf
*.sh    text eol=lf
Makefile text eol=lf
*.c     text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
# тестовый файл с концами строк Windows (CR LF) хранится как есть: тест проверяет именно их
tests/data/*crlf* -text
# двоичные файлы тестов хранятся как есть
tests/data/*.bin -text
